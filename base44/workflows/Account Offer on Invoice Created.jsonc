{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "account_offer_on_invoice",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_offer": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAccountOfferEmail",
            "args": {
              "customer_id": "${ .trigger.data.customer_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send account offer email",
            "description": "Only if no account exists"
          }
        }
      }
    ]
  },
  "description": "When an invoice is created, email the customer an invitation to create an account if they don't already have one",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Invoice"
    }
  },
  "name": "Account Offer on Invoice Created"
}