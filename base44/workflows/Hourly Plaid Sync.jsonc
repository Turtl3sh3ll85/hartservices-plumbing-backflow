{
  "description": "Pulls latest transactions from connected Plaid bank accounts every hour at the top of the hour",
  "name": "Hourly Plaid Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_plaid_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPlaidTransactions",
            "args": {
              "from_workflow": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Plaid transactions",
            "description": "Pull latest transactions from connected banks"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}