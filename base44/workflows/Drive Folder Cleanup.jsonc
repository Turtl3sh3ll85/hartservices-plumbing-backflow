{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Automatically deletes files under 2KB from the monitored Google Drive folder every hour",
  "name": "Drive Folder Cleanup",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "drive_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cleanup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deleteSmallDriveFiles"
          },
          "then": "end",
          "x-base44": {
            "title": "Delete small Drive files",
            "description": "Remove files under 2KB from monitored folder"
          }
        }
      }
    ]
  }
}