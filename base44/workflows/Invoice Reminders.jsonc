{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 2,4",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Sends per-customer invoice reminders on Tuesday (biweekly) and Thursday (weekly + biweekly) at 8am. Each email includes a link to the customer's invoice portal.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "invoice_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendInvoiceReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send invoice reminders",
            "description": "Per-customer reminder emails with portal link"
          }
        }
      }
    ]
  },
  "name": "Invoice Reminders"
}