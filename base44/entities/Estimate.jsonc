{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "number": {
      "type": "string",
      "title": "Estimate Number"
    },
    "name": {
      "type": "string",
      "title": "Estimate Name"
    },
    "line_items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "details": {
            "type": "string",
            "title": "Details"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "image_url": {
            "type": "string",
            "title": "Thumbnail URL"
          },
          "photos": {
            "type": "array",
            "title": "Photos",
            "items": {
              "type": "string"
            }
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "modifiers": {
            "type": "array",
            "title": "Modifiers",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "title": "Modifier Name"
                },
                "price_adjustment": {
                  "type": "number",
                  "title": "Price Adjustment"
                }
              }
            }
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "tax_rate": {
      "type": "number",
      "title": "Tax Rate %"
    },
    "tax": {
      "type": "number",
      "title": "Tax"
    },
    "cc_fee_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Credit Card Fee Enabled"
    },
    "cc_fee": {
      "type": "number",
      "default": 0,
      "title": "Credit Card Fee"
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "payment_schedule": {
      "type": "array",
      "title": "Payment Schedule",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "percentage",
              "amount"
            ],
            "default": "percentage",
            "title": "Type"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "paid": {
            "type": "boolean",
            "default": false,
            "title": "Paid"
          },
          "paypal_order_id": {
            "type": "string",
            "title": "PayPal Order ID"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "converted"
      ],
      "default": "draft",
      "title": "Status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "default": "unpaid",
      "title": "Payment Status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "check"
      ],
      "title": "Payment Method"
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date"
    },
    "converted_invoice_id": {
      "type": "string",
      "title": "Converted Invoice ID"
    },
    "opened": {
      "type": "boolean",
      "default": false,
      "title": "Opened by customer"
    },
    "last_opened_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Opened Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "single",
        "a_la_carte",
        "side_by_side"
      ],
      "default": "single",
      "title": "Selection Mode"
    },
    "options": {
      "type": "array",
      "title": "Estimate Options",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Option Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "line_items": {
            "type": "array",
            "title": "Line Items",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "title": "Description"
                },
                "details": {
                  "type": "string",
                  "title": "Details"
                },
                "quantity": {
                  "type": "number",
                  "title": "Quantity"
                },
                "unit_price": {
                  "type": "number",
                  "title": "Unit Price"
                },
                "image_url": {
                  "type": "string",
                  "title": "Thumbnail URL"
                },
                "photos": {
                  "type": "array",
                  "title": "Photos",
                  "items": {
                    "type": "string"
                  }
                },
                "section": {
                  "type": "string",
                  "title": "Section"
                },
                "modifiers": {
                  "type": "array",
                  "title": "Modifiers",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "title": "Modifier Name"
                      },
                      "price_adjustment": {
                        "type": "number",
                        "title": "Price Adjustment"
                      }
                    }
                  }
                }
              }
            }
          },
          "subtotal": {
            "type": "number",
            "title": "Subtotal"
          },
          "tax": {
            "type": "number",
            "title": "Tax"
          },
          "total": {
            "type": "number",
            "title": "Total"
          }
        }
      }
    },
    "selected_option_label": {
      "type": "string",
      "title": "Customer-Selected Option"
    },
    "selected_line_items": {
      "type": "array",
      "title": "Customer-Selected Line Items (a la carte)",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          }
        }
      }
    },
    "customer_ready": {
      "type": "boolean",
      "default": false,
      "title": "Customer Ready to Begin"
    },
    "customer_ready_date": {
      "type": "string",
      "format": "date-time",
      "title": "Customer Ready Date"
    },
    "standing_by": {
      "type": "boolean",
      "default": true,
      "title": "Standing By (next payment)"
    }
  },
  "required": [
    "customer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    }
  }
}