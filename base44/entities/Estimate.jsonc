{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "number": {
      "type": "string",
      "title": "Estimate Number"
    },
    "name": {
      "type": "string",
      "title": "Estimate Name"
    },
    "line_items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "details": {
            "type": "string",
            "title": "Details"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "image_url": {
            "type": "string",
            "title": "Thumbnail URL"
          },
          "photos": {
            "type": "array",
            "title": "Photos",
            "items": {
              "type": "string"
            }
          },
          "section": {
            "type": "string",
            "title": "Section"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "tax_rate": {
      "type": "number",
      "title": "Tax Rate %"
    },
    "tax": {
      "type": "number",
      "title": "Tax"
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "payment_schedule": {
      "type": "array",
      "title": "Payment Schedule",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "percentage",
              "amount"
            ],
            "default": "percentage",
            "title": "Type"
          },
          "value": {
            "type": "number",
            "title": "Value"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "converted"
      ],
      "default": "draft",
      "title": "Status"
    },
    "converted_invoice_id": {
      "type": "string",
      "title": "Converted Invoice ID"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "customer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tech"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    }
  }
}