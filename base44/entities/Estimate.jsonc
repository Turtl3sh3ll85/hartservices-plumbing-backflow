{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer"
    },
    "number": {
      "type": "string",
      "title": "Estimate Number"
    },
    "name": {
      "type": "string",
      "title": "Estimate Name"
    },
    "line_items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "image_url": {
            "type": "string",
            "title": "Thumbnail URL"
          },
          "section": {
            "type": "string",
            "title": "Section"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "tax_rate": {
      "type": "number",
      "title": "Tax Rate %"
    },
    "tax": {
      "type": "number",
      "title": "Tax"
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "payment_schedule": {
      "type": "array",
      "title": "Payment Schedule",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "percentage",
              "amount"
            ],
            "default": "percentage",
            "title": "Type"
          },
          "value": {
            "type": "number",
            "title": "Value"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "converted"
      ],
      "default": "draft",
      "title": "Status"
    },
    "converted_invoice_id": {
      "type": "string",
      "title": "Converted Invoice ID"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "customer_id"
  ]
}