{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job"
    },
    "number": {
      "type": "string",
      "title": "Invoice Number"
    },
    "name": {
      "type": "string",
      "title": "Invoice Name"
    },
    "line_items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Description"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "image_url": {
            "type": "string",
            "title": "Thumbnail URL"
          },
          "section": {
            "type": "string",
            "title": "Section"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "tax_rate": {
      "type": "number",
      "title": "Tax Rate %"
    },
    "tax": {
      "type": "number",
      "title": "Tax"
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "payment_schedule": {
      "type": "array",
      "title": "Payment Schedule",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "percentage",
              "amount"
            ],
            "default": "percentage",
            "title": "Type"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "paid": {
            "type": "boolean",
            "default": false,
            "title": "Paid"
          },
          "paypal_order_id": {
            "type": "string",
            "title": "PayPal Order ID"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "title": "Status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partial",
        "paid"
      ],
      "default": "unpaid",
      "title": "Payment Status"
    },
    "paypal_order_id": {
      "type": "string",
      "title": "PayPal Order ID"
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "opened": {
      "type": "boolean",
      "default": false,
      "title": "Opened by customer"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "job_id",
    "name"
  ]
}