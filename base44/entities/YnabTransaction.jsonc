{
  "name": "YnabTransaction",
  "type": "object",
  "properties": {
    "ynab_id": {
      "type": "string",
      "title": "YNAB Transaction ID"
    },
    "account_name": {
      "type": "string",
      "title": "Account Name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "amount": {
      "type": "number",
      "title": "Amount (milliunits)"
    },
    "payee": {
      "type": "string",
      "title": "Payee"
    },
    "category": {
      "type": "string",
      "title": "YNAB Category"
    },
    "custom_category": {
      "type": "string",
      "title": "Custom Category"
    },
    "memo": {
      "type": "string",
      "title": "Memo"
    },
    "cleared": {
      "type": "string",
      "title": "Cleared"
    },
    "matched_invoice_id": {
      "type": "string",
      "title": "Matched Invoice ID"
    },
    "matched": {
      "type": "string",
      "enum": [
        "unmatched",
        "suggested",
        "matched",
        "ignored"
      ],
      "default": "unmatched",
      "title": "Match Status"
    },
    "last_synced_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Synced Date"
    }
  },
  "required": [
    "ynab_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}