{
  "name": "Settings",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "title": "Business Name"
    },
    "business_email": {
      "type": "string",
      "title": "Business Email"
    },
    "business_phone": {
      "type": "string",
      "title": "Business Phone"
    },
    "business_street": {
      "type": "string",
      "title": "Street"
    },
    "business_city": {
      "type": "string",
      "title": "City"
    },
    "business_state": {
      "type": "string",
      "title": "State"
    },
    "business_zip": {
      "type": "string",
      "title": "ZIP"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "dark_logo_url": {
      "type": "string",
      "title": "Dark Mode Logo URL"
    },
    "default_tax_rate": {
      "type": "number",
      "title": "Default Tax Rate %"
    },
    "payment_terms": {
      "type": "string",
      "title": "Payment Terms"
    },
    "google_sheet_id": {
      "type": "string",
      "title": "Google Sheet ID for item catalog"
    },
    "receipts_folder_id": {
      "type": "string",
      "title": "Google Drive folder ID for receipts"
    },
    "weekly_summary_enabled": {
      "type": "boolean",
      "default": false,
      "title": "Weekly Open Invoices Summary Enabled"
    },
    "auto_categorize_transfers": {
      "type": "boolean",
      "default": true,
      "title": "Auto-Categorize Transfers (Plaid PFC)"
    },
    "ignore_transfers": {
      "type": "boolean",
      "default": true,
      "title": "Auto-Ignore Transfers"
    },
    "transfer_category_name": {
      "type": "string",
      "default": "Transfer",
      "title": "Transfer Category Name"
    },
    "internal_transfer_category_name": {
      "type": "string",
      "default": "Internal Transfer",
      "title": "Internal Transfer Category Name"
    },
    "external_transfer_category_name": {
      "type": "string",
      "default": "External Transfer",
      "title": "External Transfer Category Name"
    },
    "detect_internal_transfers": {
      "type": "boolean",
      "default": true,
      "title": "Detect Internal Transfers (Two-Sided Matching)"
    },
    "auto_ignore_categories": {
      "type": "array",
      "title": "Additional Auto-Ignore Categories",
      "items": {
        "type": "string"
      }
    }
  },
  "required": []
}