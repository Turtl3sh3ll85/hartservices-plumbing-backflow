{
  "name": "AccountLabel",
  "type": "object",
  "properties": {
    "account_name": {
      "type": "string",
      "title": "Account Name"
    },
    "type": {
      "type": "string",
      "enum": [
        "business",
        "personal",
        "routing"
      ],
      "title": "Type"
    },
    "merge_into": {
      "type": "string",
      "title": "Merge Into"
    }
  },
  "required": [
    "account_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accountant"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}