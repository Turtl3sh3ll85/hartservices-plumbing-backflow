{
  "name": "Contract",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job"
    },
    "title": {
      "type": "string",
      "title": "Contract Title"
    },
    "file_uri": {
      "type": "string",
      "title": "Contract File URI"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "amount": {
      "type": "number",
      "title": "Contract Amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "signed",
        "declined"
      ],
      "default": "draft",
      "title": "Status"
    },
    "signed_date": {
      "type": "string",
      "format": "date",
      "title": "Signed Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "job_id",
    "title"
  ]
}