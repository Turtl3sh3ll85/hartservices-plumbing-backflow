{
  "name": "Attachment",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job"
    },
    "type": {
      "type": "string",
      "enum": [
        "photo",
        "document"
      ],
      "default": "photo",
      "title": "Type"
    },
    "file_uri": {
      "type": "string",
      "title": "File URI"
    },
    "file_name": {
      "type": "string",
      "title": "File Name"
    },
    "caption": {
      "type": "string",
      "title": "Caption"
    }
  },
  "required": [
    "job_id",
    "type",
    "file_uri"
  ]
}